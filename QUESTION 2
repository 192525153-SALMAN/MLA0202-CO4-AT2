def viterbi(observations):

    number_of_observations = len(observations)
    number_of_states = len(states)

    probability = np.zeros(
        (number_of_states, number_of_observations)
    )

    path = np.zeros(
        (number_of_states, number_of_observations),
        dtype=int
    )
-

    for i, state in enumerate(states):

        probability[i, 0] = (
            initial_probability[state]
            * emission_probability[state][observations[0]]
        )

        path[i, 0] = 0

  

    for t in range(1, number_of_observations):

        for current_index, current_state in enumerate(states):

            probabilities = []

            for previous_index, previous_state in enumerate(states):

                value = (
                    probability[
                        previous_index,
                        t - 1
                    ]
                    * transition_probability[
                        previous_state
                    ][
                        current_state
                    ]
                )

                probabilities.append(value)

            best_previous_state = np.argmax(probabilities)

            probability[
                current_index,
                t
            ] = (
                probabilities[best_previous_state]
                * emission_probability[
                    current_state
                ][
                    observations[t]
                ]
            )

            path[
                current_index,
                t
            ] = best_previous_state

  

    best_final_state = np.argmax(
        probability[:, -1]
    )

    best_path = [
        best_final_state
    ]

    for t in range(
        number_of_observations - 1,
        0,
        -1
    ):

        best_final_state = path[
            best_final_state,
            t
        ]

        best_path.append(
            best_final_state
        )

    best_path.reverse()

    return [
        states[index]
        for index in best_path
    ], probability

