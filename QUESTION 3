print("\nTraining samples:", len(training_data))



def word_features(sentence, i):

    word = sentence[i]

    features = {
        "word.lower": word.lower(),
        "word[-2:]": word[-2:],
        "word[-3:]": word[-3:],
        "word.isupper": word.isupper(),
        "word.istitle": word.istitle(),
        "word.isdigit": word.isdigit(),
        "word.length": len(word),
        "contains_digit": any(c.isdigit() for c in word),
        "contains_upper": any(c.isupper() for c in word),
        "starts_with_capital": word[0].isupper()
    }

    # Previous word
    if i > 0:

        previous_word = sentence[i - 1]

        features.update({
            "previous.lower": previous_word.lower(),
            "previous.istitle": previous_word.istitle(),
            "previous.isupper": previous_word.isupper()
        })

    else:

        features["BOS"] = True

    # Next word
    if i < len(sentence) - 1:

        next_word = sentence[i + 1]

        features.update({
            "next.lower": next_word.lower(),
            "next.istitle": next_word.istitle(),
            "next.isupper": next_word.isupper()
        })

    else:

        features["EOS"] = True

    return features



X_train = []
y_train = []

for sentence, labels in training_data:

    sentence_features = []

    for i in range(len(sentence)):

        sentence_features.append(
            word_features(sentence, i)
        )

    X_train.append(sentence_features)
    y_train.append(labels)


crf = CRF(
    algorithm="lbfgs",
    c1=0.1,
    c2=0.1,
    max_iterations=200,
    all_possible_transitions=True
)

crf.fit(X_train, y_train)

print("CRF model trained successfully.")


